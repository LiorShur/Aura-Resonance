# Copy to .env.local and fill in. Never commit real values.
# The v0 pilot runs entirely on the Firebase emulator with SIM_MODE — you do not
# need real credentials to develop.

# --- Client (safe to expose in the bundle) ---
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-aura-resonance.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-aura-resonance
VITE_FIREBASE_STORAGE_BUCKET=demo-aura-resonance.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=demo-app-id

# Mapbox is not needed in v0 sim mode (schematic map). Required from M2 onward.
VITE_MAPBOX_TOKEN=

# Develop without going outside: mock GPS, draggable pin, fake second player.
VITE_SIM_MODE=true
# Point the Firebase SDKs at the local emulator suite.
VITE_USE_EMULATOR=true

# --- Server only (Cloud Functions) — NEVER reaches the client bundle ---
# Set these in the Functions runtime config / CI secrets, not here.
# ANTHROPIC_API_KEY=
# GOOGLE_VISION_KEY=
